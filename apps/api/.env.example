# Provably Fair RNG, API server config
# Copy this file to `.env` and adjust for your environment.

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Tenant API keys, JSON map of {tenantId: apiKey}
# In production, source these from a secrets manager (AWS Secrets Manager, GCP Secret Manager, Vault)
# and rotate at least every 90 days.
TENANT_API_KEYS={"demo-tenant":"demo-tenant-key-CHANGE-ME-IN-PRODUCTION"}

# Regulator API key, single value, read-only cross-tenant access
REGULATOR_API_KEY=regulator-key-CHANGE-ME-IN-PRODUCTION
