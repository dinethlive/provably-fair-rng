{
  "name": "provably-fair-rng-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Provably Fair RNG Engine with Verification UI, regulatorily credible HMAC-SHA256 RNG with seed lifecycle, audit log, and client-side verification.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "test": "pnpm -r test",
    "test:stat": "pnpm --filter @pf/rng-core test:stat",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @pf/api dev",
    "dev:verifier": "pnpm --filter @pf/verifier dev",
    "dev": "pnpm run --parallel dev:api dev:verifier"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.10.5",
    "turbo": "^2.3.0"
  }
}
